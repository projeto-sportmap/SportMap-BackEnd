+// Arquivo: tests/rbac.test.ts
+// Testes sem banco: o RBAC da rota administrativa com o banco simulado.
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import request from 'supertest';
+import jwt from 'jsonwebtoken';
+
+const mocks = vi.hoisted(() => ({
+  dbUsuarioFirst: vi.fn(),
+  dbTipoFirst: vi.fn(),
+  getUsuarioById: vi.fn(),
+}));
+
+vi.mock('../src/services/usuarios.service.js', () => ({
+  getUsuarioById: mocks.getUsuarioById,
+  toPublicUsuario: (u: any) => ({ id: String(u.id), nome: u.nome, email: u.email }),
+}));
+
+vi.mock('../src/prisma/db.js', () => ({
+  db: {
+    orm: {
+      public: {
+        Usuarios: { first: mocks.dbUsuarioFirst },
+        TipoUsuario: { first: mocks.dbTipoFirst },
+      },
+    },
+  },
+}));
+
+import { app } from '../src/app.js';
+import { env } from '../src/config/env.js';
+import { hasPermission } from '../src/security/permissions.js';
+
+const token = (extra: Record<string, unknown> = {}) =>
+  jwt.sign({ id: '1', ...extra }, env.JWT_SECRET, {
+    algorithm: 'HS256',
+    expiresIn: '15m',
+    issuer: 'sportmap-api',
+    audience: 'sportmap',
+  });
+
+const bearer = (t = token()) => `Bearer ${t}`;
+const alvo = { id: 2n, nome: 'Alvo', email: 'alvo@example.com' };
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: 1 });
+  mocks.dbTipoFirst.mockResolvedValue({ id: 1, code: 'USUARIO', name: 'Usuario Comum' });
+  mocks.getUsuarioById.mockResolvedValue(alvo);
+});
+
+describe('hasPermission', () => {
+  it('só ADMIN lê qualquer conta; papéis desconhecidos são negados', () => {
+    expect(hasPermission('ADMIN', 'usuarios:read:any')).toBe(true);
+    expect(hasPermission('USUARIO', 'usuarios:read:any')).toBe(false);
+    expect(hasPermission('DESCONHECIDO', 'usuarios:read:any')).toBe(false);
+    expect(hasPermission('__proto__', 'usuarios:read:any')).toBe(false);
+    expect(hasPermission('', 'usuarios:read:any')).toBe(false);
+  });
+});
+
+describe('GET /admin/usuarios/:id', () => {
+  it('401 sem login e com token inválido', async () => {
+    expect((await request(app).get('/admin/usuarios/2')).status).toBe(401);
+    const r = await request(app).get('/admin/usuarios/2').set('Authorization', 'Bearer invalido');
+    expect(r.status).toBe(401);
+  });
+
+  it('403 para USUARIO, mesmo com ID inválido (permissão vem antes da validação)', async () => {
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+    expect((await request(app).get('/admin/usuarios/abc').set('Authorization', bearer())).status).toBe(403);
+    expect(mocks.getUsuarioById).not.toHaveBeenCalled();
+  });
+
+  it('403 quando a conta não tem tipo ou o tipo é desconhecido', async () => {
+    mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: null });
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+
+    mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: 99 });
+    mocks.dbTipoFirst.mockResolvedValue({ id: 99, code: 'SUPER', name: 'Inventado' });
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+
+    mocks.dbTipoFirst.mockResolvedValue(null);
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+  });
+
+  it('um papel extra dentro do JWT não concede privilégio', async () => {
+    const r = await request(app)
+      .get('/admin/usuarios/2')
+      .set('Authorization', bearer(token({ role: 'ADMIN', tipoUsuarioId: 2 })));
+    expect(r.status).toBe(403);
+  });
+
+  describe('como ADMIN', () => {
+    beforeEach(() => {
+      mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: 2 });
+      mocks.dbTipoFirst.mockResolvedValue({ id: 2, code: 'ADMIN', name: 'Administração' });
+    });
+
+    it('200 sem senha, também por cookie', async () => {
+      const r = await request(app).get('/admin/usuarios/2').set('Authorization', bearer());
+      expect(r.status).toBe(200);
+      expect(r.body.id).toBe('2');
+      expect(r.body).not.toHaveProperty('senhaHash');
+      expect(r.body).not.toHaveProperty('senha');
+      expect((await request(app).get('/admin/usuarios/2').set('Cookie', `token=${token()}`)).status).toBe(200);
+    });
+
+    it('400 para ID inválido', async () => {
+      expect((await request(app).get('/admin/usuarios/abc').set('Authorization', bearer())).status).toBe(400);
+    });
+
+    it('rotas pessoais continuam só para a própria conta (403 em conta alheia)', async () => {
+      expect((await request(app).get('/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+      expect((await request(app).put('/usuarios/2').set('Authorization', bearer()).send({ nome: 'Outro' })).status).toBe(403);
+      expect((await request(app).delete('/usuarios/2').set('Authorization', bearer())).status).toBe(403);
+    });
+  });
+
+  it('retirar o privilégio bloqueia o mesmo token no pedido seguinte', async () => {
+    mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: 2 });
+    mocks.dbTipoFirst.mockResolvedValue({ id: 2, code: 'ADMIN', name: 'Administração' });
+    const t = bearer();
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', t)).status).toBe(200);
+
+    mocks.dbUsuarioFirst.mockResolvedValue({ id: 1n, tipoUsuarioId: 1 });
+    mocks.dbTipoFirst.mockResolvedValue({ id: 1, code: 'USUARIO', name: 'Usuario Comum' });
+    expect((await request(app).get('/admin/usuarios/2').set('Authorization', t)).status).toBe(403);
+  });
+});
